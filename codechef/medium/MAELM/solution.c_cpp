#include <bits/stdc++.h>
using namespace std;

int main() {
	int n,m;
	cin>>n>>m;
	unordered_map<int,int>fre;
	int a[n][n],b[m][m];
    for(int i=0;i<n;i++){
        for(int j=0;j<n;j++){
            int x;
            cin>>x;
            a[i][j]=x;
            fre[x]++;
        }
    }
    for(int i=0;i<m;i++){
        for(int j=0;j<m;j++){
            int x;
            cin>>x;
            b[i][j]=x;
            if(fre[x]==0){
                cout<<"FALSE"<<endl;
                return 0;
            }
            fre[x]--;
        }
    }
    cout<<"TRUE"<<endl;
    return 0;
    
}

#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    int arr[n];
	    for(int i = 0 ; i < n ; i++){
	        cin>>arr[i];
	    }
	    int count = 0 , ans = 0;
	    for(int i = n-2 ; i >= 0  ; i--){
	        if(arr[i] < arr[i + 1]){
	            count++;
	        }else{
	            count = 0;
	        }
	        ans = max (ans , count);
	    }
	    cout<<ans<<endl;
	}

}

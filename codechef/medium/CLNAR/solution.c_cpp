#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    int arr[n];
	    for(int i = 0 ; i < n ; i++){
	        cin>>arr[i];
	    }
	    int count = 0;
	    int m = arr[n-1];
	    for(int i = n-2 ; i >= 0  ; i--){
	        if(arr[i] < m){
	            count = max(count , n - 1 - i);
	        }
	        m = max(m , arr[i]);
	    }
	    cout<<count<<endl;
	}

}

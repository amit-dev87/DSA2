#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    int arr[n];
	    for(int i = 0 ; i < n ; i++){
	        cin>>arr[i];
	    }
	    int count = 0;
	    int m = arr[n-1];
	    for(int i = n-2 ; i >= 0  ; i--){
	        if(m > arr[i]){
	            count = max()
	            count++;
	        }
	    }
	    cout<<count<<endl;
	}

}

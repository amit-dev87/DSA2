#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    int a,sum = 0;
	    cin>>a;
	    if(a==0){
	        cout<<"invalid"<<endl;
	    }
	    while(a!=0){
	        sum+=a%10;
	        a/=10;
	    }
	    if(sum % 10 == 0){
	        cout<<"valid"<<endl;
	    }else{
	        cout<<"invalid"<<endl;
	    }
	}
}

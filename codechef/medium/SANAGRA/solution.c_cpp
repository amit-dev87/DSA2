#include <bits/stdc++.h>
using namespace std;
bool isAnagram(string s , string t){
    int freq[26] = {0};
    for(char c : s){
        if(isalpha(c)){
            freq[tolower(c) - 'a']++;
        }
    }
    for(char c : t){
        if(isalpha(c)){
            freq[tolower(c) - 'a']--;
        }
    }
    for(int i = 0 ; i < 26 ; i++){
        if(freq[i] != 0){
            return false;
        }
    }
    return true;
}
int main() {
	string a;
	getline(cin , a);
	string b;
	getline(cin , b);
	if(isAnagram(a,b)){
	    cout<< "The sentences are anagrams.";
	}else{
	    cout<< "The sentences are not anagrams.";
	}
}


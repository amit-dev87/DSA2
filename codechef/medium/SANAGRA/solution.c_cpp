#include <bits/stdc++.h>
using namespace std;
bool isAnagram(string s , string t){
    int freq[256] = {0};
    for(char c : s){
        if(c != ' '){
            freq[tolower(c)]++;
        }
    }
    for(char c : t){
        if(c != ' '){
            freq[tolower(c)]--;
        }
    }
    for(int i = 0 ; i < 256 ; i++){
        if(freq[i] != 0){
            return false;
        }
    }
    return true;
}
int main() {
	string a;
	getline(cin , a);
	string b;
	getline(cin , b);
	if(isAnagram(a,b)){
	    cout<< "The sentences are anagrams.";
	}else{
	    cout<< "The sentences are not anagrams.";
	}
	

}


#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    int n ;
	    cin>>n;
	    int arr[n];
	    for(int i =0 ;i < n; i++){
	        cin>>arr[i];
	    }
	    int count = 0;
	    for(int i = 0 ; i < n ; i++){
	        bool isA = true;
	        int key = arr[i];
	        for (int j = max(0, i - 5); j < i; j++) {
	            if(key>=arr[j]){
	                isA = false;
	                break;
	            }
	        }
	        if(isA){
	           count++;
	            }
	    }
	    cout<<count<<endl;
	}
}

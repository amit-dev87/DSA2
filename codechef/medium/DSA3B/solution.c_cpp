#include <bits/stdc++.h>
using namespace std;

int main() {
	int t ;
	cin>>t;
	while(t--){
	    int n , x ,sum = 0;
	     cin>>n>>x;
	     int a[n];
	     for(int i =0 ; i < n ; i++){
	         cin>>a[i];
	     }
	     for(int i = 0 ; i < x ; i++){
	         sum += a[i];
	     }
	     int m = sum;
	     for(int i = x ; i < n ; i++){
	         sum -= a[i-x];
	         sum += a[i];
	         m = max(m , sum);
	     }
	     cout<<m<<endl;
	}

}

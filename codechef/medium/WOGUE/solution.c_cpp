#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    string s;
	    string r;
	    string m(5 , ' ');
	    cin>>s>>r;
	    for(int i = 0 ; i < 5 ; i++){
	        if(s[i] == r[i]){
	            m[i] = 'G';
	        }else{
	            m[i] = 'B';
	        }
	    }
	    for(char i : m){
	        cout<<i;
	    }
	    cout<<endl;
	}

}

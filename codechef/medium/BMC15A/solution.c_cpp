#include <bits/stdc++.h>
using namespace std;
int hcf(int a, int b) {
    if (b == 0) {
        return a;
    }
    return hcf(b, a % b);
}
int main() {
	int t;
	cin>>t;
	while(t--){
	    int n , m ;
	    cin>>n>>m;
	    if(n ==1 || m ==1){
	        cout<<1<<endl;
	    }else{
	        cout<<hcf(n,m)<<endl;
	    }
	    
	}

}


#include <bits/stdc++.h>
using namespace std;

int main() {
	int n;
	cin>>n;
	string s(n);
    for(int i = 0 ; i < n ; i++){
        cin>>s[i];
    }
    int a = 0 , b = 0;
    int m = 0 , p = 0 ;
    while(b < n){
        if(b == m){
            b++;
        }else{
            a = b + 1;
            p = b-1;
        }
    }
}

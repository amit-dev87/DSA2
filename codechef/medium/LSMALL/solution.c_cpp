#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    string s;
	    cin>>s;
	    int k;
	    cin>>k;
	    
	    string st;
	    int n = s.size();
	    for(int i= 0 ; i  < n ; i++){
	        while(!st.empty() && st.back() > s[i] && st.size() + n - i > k){
	            st.pop_back();
	        }
	        if(st.size() < k){
	            st.push_back(s[i]);
	        }
	    }
	    cout << st <<endl;
	     
	}

}

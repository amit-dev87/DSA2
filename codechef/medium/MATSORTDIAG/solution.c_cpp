#include <bits/stdc++.h>
using namespace std;

int main() {
	int n , m ;
	cin>>n>>m;
	int a[n][m];
	for(int i = 0 ; i < n ; i++){
	    for(int j = 0 ; j < m ; j++){
	        cin>>a[i][j];
	    }
	}
	for(int i = 0 ; i < n ; i++){
	    for(int j = 0 ; j < m ; j++){
	        vector<int>ans;
	        int x = i , y = j;
	        while(x < n  && y < m){
	            ans.push_back(a[x][y]);
	            x++;
	            y++;
	        }
	        sort(ans.begin() , ans.end());
	        x = i, y = j;
	        int k = 0;
	        while(x < n && y < m){
	            a[x][y] = ans[k++];
	            x++;
	            y++;
	        }
	    }
	}
	for(int i = 0 ; i < n ; i++){
	    for(int j = 0 ; j < m ; j++){
	        cout<<a[i][j]<<" ";
	    }
	    cout<<endl;
	}

}

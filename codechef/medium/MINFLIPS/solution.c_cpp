#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    int n , cpos = 0 , cneg = 0;
	    cin>>n;
	    for(int i = 1 ; i <= n ; i++){
	        int x;
	        cin>>x;
	        if(x == -1){
	            cneg++;
	        }else{
	            cpos++;
	        }
	    }
        if (n % 2 != 0) {
            cout << -1 << endl;
        } else {
            cout << abs(cpos - cneg) / 2 << endl;
        }
	}

}

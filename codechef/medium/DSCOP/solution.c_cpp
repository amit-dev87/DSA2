#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    string n;
        cin >> n;
    
        int pos = n.size() - 1;
    
        for(int i = 0; i < n.size() - 1; i++) {
            if(n[i] > n[i + 1]) {
                pos = i;
                break;
            }
        }
    
        n.erase(pos, 1);
    
        int i = 0;
        while(i < n.size() - 1 && n[i] == '0') {
            i++;
        }
    
        cout << n.substr(i)<<endl;
    
    	}

}

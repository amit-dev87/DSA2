#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    int n;
	    int count = 0;
	    cin>>n;
	    while(n!=4){
	        n/=4;
	    }
	    while(n!=0){
	        n/=2;
	        count++;
	    }
	    if(count >= 1){
	        cout<<"yes"<<endl;
	    }else{
	        cout<<"no"<<endl;
	    }
	}

}

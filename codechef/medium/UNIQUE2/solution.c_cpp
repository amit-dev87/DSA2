#include <bits/stdc++.h>
using namespace std;

int main() {
	int n;
	cin>>n;
	int arr[n];
	vector<int>ans;
	unordered_map<int,int>m;
	for(int i = 0 ; i < n ; i++){
	    int a;
	    cin>>a;
	    if(m[a]==0){
	        ans.push_back(a);
	    }
	    m[a]++;
	}
	for(int i : ans){
	    cout<<i<<" ";
	}
	

}
